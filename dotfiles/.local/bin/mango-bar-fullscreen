#!/usr/bin/env python3
"""Hide Noctalia's left bar while a fullscreen window is visible.

Mango draws the bar on the overlay layer (so panels sit above fullscreen
apps), which also means the bar would sit on top of fullscreen video. Watch
the client list and use Noctalia's own bar-hide/bar-show IPC, which animates
the bar out and back in instead of tearing the surface down.
"""

import json
import subprocess
import time

BAR = "main"


def set_bar(shown):
    subprocess.run(
        ["noctalia", "msg", "bar-show" if shown else "bar-hide", BAR],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def has_fullscreen(payload):
    for client in payload.get("clients", []):
        if client.get("is_fullscreen") and client.get("is_visible"):
            return True
    return False


def main():
    hidden = False

    while True:
        proc = subprocess.Popen(
            ["mmsg", "watch", "all-clients"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
        try:
            for line in proc.stdout:
                line = line.strip()
                if not line:
                    continue
                try:
                    payload = json.loads(line)
                except json.JSONDecodeError:
                    continue

                fullscreen = has_fullscreen(payload)
                if fullscreen and not hidden:
                    hidden = True
                    set_bar(False)
                elif not fullscreen and hidden:
                    hidden = False
                    set_bar(True)
        finally:
            proc.terminate()
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                proc.kill()

        time.sleep(2)


if __name__ == "__main__":
    main()
