## Genix7000 spin -- generated by plymouth-manim/make_theme.py
## Modeled on adi1090x's plymouth-themes template (GPL-3.0)

// Screen size
screen.w = Window.GetWidth(0);
screen.h = Window.GetHeight(0);
screen.half.w = Window.GetWidth(0) / 2;
screen.half.h = Window.GetHeight(0) / 2;

// Pitch black background (both halves must be set)
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

// Password prompt bullets
bullets = null;
prompt = null;
bullet.image = Image.Text("*", 1, 1, 1);

// ---------------------------------------------------------------- spin ----

# preload every frame of the manim render
for (i = 0; i < 60; i++)
  logo_image[i] = Image("logo-" + i + ".png");

logo_sprite = Sprite();
logo_sprite.SetX(screen.half.w - logo_image[0].GetWidth() / 2);
logo_sprite.SetY(screen.half.h - logo_image[0].GetHeight() / 2);

progress = 0;

# NOTE: Plymouth's Sprite API has no SetScale/SetRotation. Frames are
# pre-rendered at their display size (see scene.py), so only swap images.
fun refresh_callback ()
  {
    logo_sprite.SetImage(logo_image[Math.Int(progress / 2) % 60]);
    progress++;
  }

refresh_callback();
Plymouth.SetRefreshFunction (refresh_callback);

# ------------------------------------------------- password prompt -------
fun DisplayPasswordCallback(nil, bulletCount) {
    totalWidth = bulletCount * bullet.image.GetWidth();
    startPos = screen.half.w - totalWidth / 2;

    prompt.image = Image.Text("Enter Password", 1, 1, 1);
    prompt.sprite = Sprite(prompt.image);
    prompt.sprite.SetX(screen.half.w - prompt.image.GetWidth() / 2);
    prompt.sprite.SetY(screen.h - 2 * prompt.image.GetHeight());

    // Clear all bullets (user might hit backspace)
    bullets = null;
    for (i = 0; i < bulletCount; i++) {
        bullets[i].sprite = Sprite(bullet.image);
        bullets[i].sprite.SetX(startPos + i * bullet.image.GetWidth());
        bullets[i].sprite.SetY(screen.h - prompt.image.GetHeight());
    }
}
Plymouth.SetDisplayPasswordFunction(DisplayPasswordCallback);

# ------------------------------------------------- normal display --------
fun DisplayNormalCallback() {
    bullets = null;
    prompt = null;
    message = null;
}
Plymouth.SetDisplayNormalFunction(DisplayNormalCallback);

# ------------------------------------------------- message ---------------
fun MessageCallback(text) {
    message.image = Image.Text(text, 1, 1, 1);
    message.sprite = Sprite(message.image);
    message.sprite.SetX(screen.half.w - message.image.GetWidth() / 2);
    message.sprite.SetY(screen.h - 4 * message.image.GetHeight());
}
Plymouth.SetMessageFunction(MessageCallback);
