# Machine-specific settings for the current laptop.
# Everything hardware-independent is in ../../modules/common.nix.
{ config, pkgs, ... }:

{
  imports = [
    # Generated by nixos-generate-config on this machine.
    ./hardware-configuration.nix
  ];

  # ─── NVIDIA dGPU (kept after gaming purge) ──────────────────────────────
  # RTX 2050 (GA107) hybrid laptop: proprietary (open = false) is the safe
  # default; nouveau cannot run DXVK and is unstable on this chip.
  services.xserver.videoDrivers = [ "nvidia" ];

  hardware.nvidia = {
    modesetting.enable = true; # required for Wayland
    open = false;
    package = config.boot.kernelPackages.nvidiaPackages.stable;

    # Hybrid laptop support (suspend/resume)
    powerManagement.enable = true;

    prime = {
      # From lspci: NVIDIA 0000:01:00.0, Intel 0000:00:02.0
      intelBusId = "PCI:0:2:0";
      nvidiaBusId = "PCI:1:0:0";
    };
  };

  # GRUB bootloader (switched from systemd-boot — os-prober auto-detects
  # Windows on its separate ESP, nvme0n1p1/UUID 8CD9-0CA4, so no F12 needed).
  # The Graphite GRUB theme is vendored at ../../graphite-grub (default grey
  # colorway, 1080p variant), packaged the same way as future-cursors.
  boot.loader.grub = {
    enable = true;
    device = "nodev";
    efiSupport = true;
    useOSProber = true;
    configurationLimit = 5;
    theme = pkgs.runCommand "graphite-grub" {
      preferLocalBuild = true;
      allowSubstitutes = false;
    } ''
      cp -r ${../../graphite-grub} $out
    '';
  };
  # Removable-path insurance: a second GRUB at EFI/BOOT/BOOTX64.EFI, which
  # the firmware's fallback path picks up even if NVRAM gets wiped (firmware
  # update / CMOS reset). Requires canTouchEfiVariables to be OFF — NixOS
  # then never writes NVRAM itself; the boot order stays as set manually
  # via efibootmgr (Boot0003 GRUB first; Boot0000 systemd-boot stays as
  # the rescue entry and is NOT deleted).
  boot.loader.grub.efiInstallAsRemovable = true;
  boot.loader.efi.canTouchEfiVariables = false;
  boot.loader.efi.efiSysMountPoint = "/boot";

  boot = {
    consoleLogLevel = 3;
    initrd.verbose = false;
    # Load the Intel KMS driver in the initrd so the display is already on
    # i915 before plymouthd starts. Otherwise simpledrm owns the screen
    # first and i915 takes over mid-splash (screen off/on + stale GRUB
    # framebuffer flashes).
    initrd.kernelModules = [ "i915" ];
    kernelParams = [
      "quiet"
      "splash"
      "rd.systemd.show_status=auto"
      "rd.udev.log_level=3"
    ];
    plymouth = {
      enable = true;
      theme = "genix";
      themePackages = [
        (pkgs.callPackage ../../plymouth-theme-genix.nix { })
      ];
    };
  };

  networking.hostName = "nixos"; # Define your hostname.

  # Set your time zone.
  time.timeZone = "Asia/Kolkata";

  # This is the first NixOS version installed on this machine. Do not change
  # it when reusing this config on another machine: give the new host its own
  # stateVersion matching the release it was installed with.
  system.stateVersion = "26.05";
}
